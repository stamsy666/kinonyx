node_modules
dist
target
*.log
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea
*.local

# Secrets: Kinopoisk API key, TorAPI base URL if it ever carries a token.
.env
.env.*
!.env.example

# Native libmpv runtime libraries (100MB+, fetched via
# `npx tauri-plugin-libmpv-api setup-lib` from apps/desktop) — never commit these.
apps/desktop/src-tauri/lib/

# Torrserve sidecar binary — fetched per-platform, not committed.
apps/desktop/src-tauri/binaries/

# Built/cloned native dependencies (whisper.cpp for the local translator).
third_party/

# Local translator: whisper-server.exe is built from third_party/whisper.cpp (see CLAUDE.md), not committed.
apps/desktop/src-tauri/translator/*.exe

# Updater signing keys — NEVER commit.
*.key
*.key.pub
.tauri/
