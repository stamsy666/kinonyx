{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KINONYX",
  "version": "1.0.4",
  "identifier": "com.kinonyx.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "KINONYX",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "transparent": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "PASTE_PUBLIC_KEY_HERE",
      "endpoints": [
        "https://github.com/stamsy666/kinonyx/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "lib/**/*",
      "translator/**/*"
    ],
    "externalBin": [
      "binaries/torrserve"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "Russian",
          "English"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}
