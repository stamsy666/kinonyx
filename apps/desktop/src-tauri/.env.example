# Copy to .env next to this file (gitignored) and fill in — see CLAUDE.md
# "Настройка окружения". dotenvy looks for .env starting from the process's
# working directory (src-tauri/ for `cargo build`/`tauri dev`) upward, so it
# must live here and NOT in apps/desktop/.
KINOPOISK_API_KEY=
TORAPI_BASE_URL=https://ohnofreefilms.vercel.app
TORRSERVE_PORT=8090
