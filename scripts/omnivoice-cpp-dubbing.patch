--- a/src/tts-server.h
+++ b/src/tts-server.h
@@ -46,6 +46,16 @@ struct tts_request {
     // random seed per request, matching the CLI convention; anything
     // else forwards verbatim for reproducible output.
     int64_t seed;
+
+    // Timing control for dubbing (all optional, 0 = off).
+    // duration > 0 forces exactly that length in seconds. Otherwise
+    // max_duration > 0 fits the line into a slot: the natural length when
+    // it fits, else faster by at most max_speedup, never shorter than the
+    // slot. steps > 0 overrides the MaskGIT step count (default 32).
+    float duration     = 0.0f;
+    float max_duration = 0.0f;
+    float max_speedup  = 1.0f;
+    int   steps        = 0;
 };
 
 // One voice registration parsed from the POST /v1/audio/voices JSON body.
@@ -174,6 +184,28 @@ static bool tts_parse_request(const std::string & body, tts_request & req, std::
     }
     req.seed = seed ? yyjson_get_sint(seed) : -1;
 
+    const char * numeric[] = { "duration", "max_duration", "max_speedup" };
+    float *      targets[] = { &req.duration, &req.max_duration, &req.max_speedup };
+    for (int i = 0; i < 3; i++) {
+        yyjson_val * v = yyjson_obj_get(root, numeric[i]);
+        if (!v) {
+            continue;
+        }
+        if (!yyjson_is_num(v) || yyjson_get_num(v) < 0.0) {
+            err = std::string("'") + numeric[i] + "' must be a non-negative number";
+            yyjson_doc_free(doc);
+            return false;
+        }
+        *targets[i] = (float) yyjson_get_num(v);
+    }
+    yyjson_val * steps = yyjson_obj_get(root, "steps");
+    if (steps && (!yyjson_is_int(steps) || yyjson_get_sint(steps) < 1 || yyjson_get_sint(steps) > 64)) {
+        err = "'steps' must be an integer between 1 and 64";
+        yyjson_doc_free(doc);
+        return false;
+    }
+    req.steps = steps ? (int) yyjson_get_sint(steps) : 0;
+
     yyjson_doc_free(doc);
 
     if (req.format != "pcm" && req.format != "wav") {
